# =============================================================================
# LyricalAI - Docker / production environment
# Copy to `.env` and replace every placeholder before deploying.
# `.env` is git-ignored: never commit real secrets.
# =============================================================================

# --- Database (PostgreSQL container) -----------------------------------------
POSTGRES_DB=lyricalai
POSTGRES_USER=lyricalai
# CHANGE ME: use a long random password.
POSTGRES_PASSWORD=change_me
# Leave empty to connect to the bundled `postgres` service using the values
# above. Set it only to use an external database, e.g.
# DATABASE_URL=postgresql://user:password@db.example.com:5432/lyricalai
DATABASE_URL=

# --- Security ------------------------------------------------------------------
# CHANGE ME: signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Browser origins allowed to call the API directly (comma separated). Not needed
# when the site is served through the bundled Nginx (same origin); set it to your
# public URL anyway, e.g. https://lyrics.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Uploads -------------------------------------------------------------------
MAX_FILE_SIZE_MB=50
# Keep this a little above MAX_FILE_SIZE_MB.
NGINX_CLIENT_MAX_BODY_SIZE=60m
MAX_DURATION_MINUTES=15
# Hours to keep uploaded media for playback (lyrics are kept until deleted).
FILE_RETENTION_HOURS=72
STORAGE_PATH=/app/storage

# --- AI models -------------------------------------------------------------------
# tiny | base | small | medium  (bigger = more accurate, slower, more RAM)
WHISPER_MODEL=small
# auto | cpu | cuda  (auto uses the GPU when one is available)
DEVICE=auto
DEMUCS_MODEL=htdemucs
# Download/load the models when the server starts instead of on the first upload.
PRELOAD_MODELS=true
# If Demucs fails, transcribe the full mix (with a warning) instead of failing.
ENABLE_SEPARATION_FALLBACK=true

# --- Web -----------------------------------------------------------------------
# Host port and address the site is published on. Behind a host-level HTTPS
# proxy use APP_BIND=127.0.0.1 so only the proxy can reach it.
APP_PORT=8080
APP_BIND=0.0.0.0
LOG_LEVEL=INFO
