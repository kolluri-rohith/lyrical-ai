# =============================================================================
# LyricalAI - Docker / production environment
# Copy to `.env` and replace every placeholder before deploying.
# `.env` is git-ignored: never commit real secrets.
# =============================================================================

# --- Database (PostgreSQL container) -----------------------------------------
POSTGRES_DB=lyricalai
POSTGRES_USER=lyricalai
# CHANGE ME: use a long random password.
POSTGRES_PASSWORD=change_me
# Leave empty to connect to the bundled `postgres` service using the values
# above. Set it only to use an external database, e.g.
# DATABASE_URL=postgresql://user:password@db.example.com:5432/lyricalai
DATABASE_URL=

# --- Security ------------------------------------------------------------------
# CHANGE ME: signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Browser origins allowed to call the API directly (comma separated). Not needed
# when the site is served through the bundled Nginx (same origin); set it to your
# public URL anyway, e.g. https://lyrics.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Uploads -------------------------------------------------------------------
MAX_FILE_SIZE_MB=50
# Keep this a little above MAX_FILE_SIZE_MB.
NGINX_CLIENT_MAX_BODY_SIZE=60m
MAX_DURATION_MINUTES=15
# Hours to keep uploaded media for playback (lyrics are kept until deleted).
FILE_RETENTION_HOURS=72
STORAGE_PATH=/app/storage

# --- Transcription -------------------------------------------------------------
# cloud = send the audio to an OpenAI-compatible Whisper API (no model in memory).
# lite  = run a small Whisper model on this machine's CPU: no API key, no PyTorch
#         (needs requirements-lite.txt; in Docker also INSTALL_LOCAL_MODELS=lite).
#         Use WHISPER_MODEL=tiny or base on a small instance.
# local = run Demucs + Whisper on this machine (needs requirements-local.txt and
#         several GB of RAM; in Docker also INSTALL_LOCAL_MODELS=true).
TRANSCRIPTION_BACKEND=cloud
# CHANGE ME (cloud only): API key for the transcription service. The default endpoint
# is Groq, which has a free tier: create a key at https://console.groq.com/keys and
# paste it here (it starts with gsk_).
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint. For OpenAI (paid): https://api.openai.com/v1
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Must return segment timestamps (verbose_json): whisper-large-v3 on Groq, whisper-1 on OpenAI.
OPENAI_TRANSCRIPTION_MODEL=whisper-large-v3

# --- In-process AI models (TRANSCRIPTION_BACKEND=lite or local) ------------------
# Docker build: false | lite | true  (must match TRANSCRIPTION_BACKEND, see above)
INSTALL_LOCAL_MODELS=false
# tiny | base | small | medium  (bigger = more accurate, slower, more RAM)
WHISPER_MODEL=small
# auto | cpu | cuda  (auto uses the GPU when one is available)
DEVICE=auto
DEMUCS_MODEL=htdemucs
# Download/load the models when the server starts instead of on the first upload.
PRELOAD_MODELS=true
# If Demucs fails, transcribe the full mix (with a warning) instead of failing.
ENABLE_SEPARATION_FALLBACK=true
# Full paths to ffmpeg / ffprobe, only needed when they are not on PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# --- Web -----------------------------------------------------------------------
# Host port and address the site is published on. Behind a host-level HTTPS
# proxy use APP_BIND=127.0.0.1 so only the proxy can reach it.
APP_PORT=8080
APP_BIND=0.0.0.0
LOG_LEVEL=INFO
