# =============================================================================
# LyricalAI backend - LOCAL development (running uvicorn without Docker)
# Copy to `backend/.env`. Docker ignores this file; it uses the root `.env`.
# =============================================================================

# SQLite needs no setup and is fine for local development.
DATABASE_URL=sqlite:///./lyricalai-dev.db
# To use a local PostgreSQL instead, clear DATABASE_URL and fill these in:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=lyricalai
# POSTGRES_USER=lyricalai
# POSTGRES_PASSWORD=change_me

JWT_SECRET_KEY=change_me_to_a_long_random_string
CORS_ORIGINS=http://localhost:5173

STORAGE_PATH=../storage
MAX_FILE_SIZE_MB=50
MAX_DURATION_MINUTES=15
FILE_RETENTION_HOURS=72

# --- Transcription -------------------------------------------------------------
# cloud = send the audio to an OpenAI-compatible Whisper API (no model in memory).
# lite  = run a small Whisper model on this machine's CPU: no API key, no PyTorch
#         (needs requirements-lite.txt; in Docker also INSTALL_LOCAL_MODELS=lite).
#         Use WHISPER_MODEL=tiny or base on a small instance.
# local = run Demucs + Whisper on this machine (needs requirements-local.txt and
#         several GB of RAM; in Docker also INSTALL_LOCAL_MODELS=true).
TRANSCRIPTION_BACKEND=cloud
# CHANGE ME (cloud only): API key for the transcription service. The default endpoint
# is Groq, which has a free tier: create a key at https://console.groq.com/keys and
# paste it here (it starts with gsk_).
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint. For OpenAI (paid): https://api.openai.com/v1
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Must return segment timestamps (verbose_json): whisper-large-v3 on Groq, whisper-1 on OpenAI.
OPENAI_TRANSCRIPTION_MODEL=whisper-large-v3

# --- In-process AI models (TRANSCRIPTION_BACKEND=lite or local) --------------
# tiny | base | small | medium
WHISPER_MODEL=small
# auto | cpu | cuda
DEVICE=auto
DEMUCS_MODEL=htdemucs
PRELOAD_MODELS=false
# Where model weights are downloaded (about 550 MB for the defaults).
MODEL_CACHE_DIR=../models
ENABLE_SEPARATION_FALLBACK=true
# Full paths to ffmpeg / ffprobe, only needed when they are not on PATH.
FFMPEG_PATH=
FFPROBE_PATH=
LOG_LEVEL=INFO
